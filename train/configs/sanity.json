{
  "_comment": "Phase 1: kurzer Sanity-Lauf. Prüft, ob Rewards, Obs, State-Setter, Checkpoints und Skill-Tracking zusammen laufen und ob die Ballkontaktrate steigt.",
  "env": {
    "tick_skip": 8,
    "max_players": 3,
    "action_stack_size": 5,
    "no_touch_timeout_secs": 15.0,
    "game_timeout_secs": 120.0,
    "mode_mix": [1.0, 0.0, 0.0]
  },
  "rewards": {
    "goal": 10.0,
    "concede": 10.0,
    "touch_ball_to_goal_accel": 1.0,
    "offensive_potential_krc": 1.0,
    "dist_weighted_align_krc": 0.5,
    "velocity_player_to_ball": 0.1,
    "save_boost": 0.3,
    "in_air": 0.02,
    "team_spirit": 0.0
  },
  "state_setters": {
    "kickoff": 1.0,
    "random": 1.0
  },
  "learner": {
    "num_threads": 16,
    "num_games_per_thread": 64,
    "device": "cuda",
    "timestep_limit": 20000000,
    "timesteps_per_iteration": 100000,
    "timesteps_per_save": 5000000,
    "checkpoints_to_keep": 3,
    "checkpoint_folder": "runs/sanity/checkpoints",
    "policy_layer_sizes": [512, 512, 512],
    "critic_layer_sizes": [512, 512, 512],
    "ppo_epochs": 2,
    "ppo_batch_size": 100000,
    "ppo_mini_batch_size": 50000,
    "ent_coef": 0.01,
    "policy_lr": 0.0002,
    "critic_lr": 0.0002,
    "gae_gamma": 0.9954
  },
  "metrics": {
    "send_metrics": false,
    "skill_tracker": true,
    "skill_timesteps_per_version": 5000000,
    "skill_max_versions": 4
  }
}
