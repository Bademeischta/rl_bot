+	// RLbot patch (speed, G2): the steps of one player in one game as plain arrays. The collection
+	// loop appends here without any torch op (GameTrajectory::AppendSingleStep costs ~20 small
+	// torch ops per player and step, 0.36 s of 0.92 s collection time per iteration); the manager
+	// merges all of them into the GameTrajectory tensors once per iteration
+	// (ThreadAgentManager::CollectTimesteps). Values and order are exactly those of the old path.
+	struct RawTrajectory {
+		std::vector<float> states, nextStates; // size * obsSize
+		std::vector<int64_t> actions;
+		std::vector<float> logProbs, rewards, dones, truncateds;
+		size_t size = 0;
+
+		void AppendSingleStep(
+			const float* state, const float* nextState, int obsSize,
+			int64_t action, float logProb, float reward, float done, float truncated
+		) {
+			states.insert(states.end(), state, state + obsSize);
+			nextStates.insert(nextStates.end(), nextState, nextState + obsSize);
+			actions.push_back(action);
+			logProbs.push_back(logProb);
+			rewards.push_back(reward);
+			dones.push_back(done);
+			truncateds.push_back(truncated);
+			size++;
+		}
+
+		// Keeps the capacity (no allocations in the steady state)
+		void Clear() {
+			states.clear(); nextStates.clear(); actions.clear();
+			logProbs.clear(); rewards.clear(); dones.clear(); truncateds.clear();
+			size = 0;
+		}
