--- cuda.cmake.orig	2026-09-23 13:23:57.250086600 +0200
+++ cuda.cmake	2026-09-23 13:23:57.318464900 +0200
@@ -53,7 +53,14 @@
 if("${CMAKE_CXX_COMPILER_ID}" MATCHES "Clang")
   set(CMAKE_CUDA_HOST_COMPILER "${CMAKE_CXX_COMPILER}")
 endif()
-enable_language(CUDA)
+if(RLBOT_SKIP_CUDA_LANGUAGE)
+  # Patch: nvcc 12.8 kann MSVC 14.51 (VS 2026) nicht als Host-Compiler nutzen (cudafe++ crasht).
+  # Wir kompilieren keine .cu-Dateien, sondern linken nur die vorgebaute torch_cuda.dll,
+  # deshalb wird die CUDA-Sprache hier nicht aktiviert.
+  message(STATUS "RLbot: skipping enable_language(CUDA)")
+else()
+  enable_language(CUDA)
+endif()
 if("X${CMAKE_CUDA_STANDARD}" STREQUAL "X" )
   set(CMAKE_CUDA_STANDARD ${CMAKE_CXX_STANDARD})
 endif()
@@ -66,6 +73,9 @@
 endif()
 
 find_package(CUDAToolkit REQUIRED)
+if(RLBOT_SKIP_CUDA_LANGUAGE)
+  set(CMAKE_CUDA_COMPILER_VERSION "${CUDAToolkit_VERSION}")
+endif()
 
 cmake_policy(POP)
 
